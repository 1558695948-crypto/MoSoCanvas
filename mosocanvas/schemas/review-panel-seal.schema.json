{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/review-panel-seal-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "moso.review-panel-seal/0.1"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generation_context_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "members": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "review_context_id": {
            "type": "string",
            "minLength": 1
          },
          "blind_path": {
            "type": "string",
            "minLength": 1
          },
          "blind_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "reviewer_id",
          "review_context_id",
          "blind_path",
          "blind_sha256"
        ]
      }
    }
  },
  "required": [
    "schema",
    "artifact_path",
    "artifact_sha256",
    "generation_context_id",
    "created_at",
    "members"
  ]
}
