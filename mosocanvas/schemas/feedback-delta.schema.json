{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/feedback-delta-0.1.json",
  "title": "MoSoCanvas Feedback Delta 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "task_id",
    "created_at",
    "source",
    "parent",
    "changes",
    "preserve",
    "prohibit",
    "relationships",
    "promotions",
    "verification",
    "confirmation_status"
  ],
  "properties": {
    "schema": { "const": "moso.feedback-delta/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message_ref", "summary"],
      "properties": {
        "kind": { "enum": ["user-feedback", "artifact-review", "production-finding"] },
        "message_ref": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_ref", "checkpoint_ref"],
      "properties": {
        "spec_ref": { "type": "string", "minLength": 1 },
        "spec_version": { "type": "integer", "minimum": 1 },
        "checkpoint_ref": { "type": "string", "minLength": 1 },
        "attempt_id": { "type": "string", "minLength": 1 }
      }
    },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "preserve": {
      "type": "array",
      "items": { "$ref": "#/$defs/invariant" }
    },
    "prohibit": {
      "type": "array",
      "items": { "$ref": "#/$defs/prohibition" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "promotions": {
      "type": "array",
      "items": { "$ref": "#/$defs/promotion" }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verification" }
    },
    "confirmation_status": { "enum": ["confirmed", "inferred", "pending"] },
    "known_tradeoff": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    { "properties": { "changes": { "minItems": 1 } } },
    { "properties": { "preserve": { "minItems": 1 } } },
    { "properties": { "prohibit": { "minItems": 1 } } },
    { "properties": { "relationships": { "minItems": 1 } } },
    { "properties": { "promotions": { "minItems": 1 } } }
  ],
  "$defs": {
    "scale": {
      "enum": ["thumbnail", "use-scale", "full-frame", "detail", "print-distance", "all"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "instruction", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "invariant", "scale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "invariant": { "type": "string", "minLength": 1 },
        "scale": { "$ref": "#/$defs/scale" }
      }
    },
    "prohibition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "consequence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "consequence": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "relation",
        "object",
        "intended_effect",
        "scale",
        "pass_condition"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "object": { "type": "string", "minLength": 1 },
        "intended_effect": { "type": "string", "minLength": 1 },
        "scale": { "$ref": "#/$defs/scale" },
        "pass_condition": { "type": "string", "minLength": 1 }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unexpected_feature", "new_role", "preserve_as"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "unexpected_feature": { "type": "string", "minLength": 1 },
        "new_role": { "type": "string", "minLength": 1 },
        "preserve_as": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "covers", "method", "pass_condition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "method": { "type": "string", "minLength": 1 },
        "pass_condition": { "type": "string", "minLength": 1 }
      }
    }
  }
}
