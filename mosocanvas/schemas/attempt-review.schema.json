{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/attempt-review-0.1.json",
  "title": "MoSoCanvas Attempt Review 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "attempt_id",
    "artifact_ref",
    "reviewed_at",
    "actual_artifact_inspected",
    "scales",
    "strengths",
    "deviations",
    "technical_risks",
    "target_change",
    "protected_drift",
    "priority_improvement",
    "recommendation",
    "communicated_to_user"
  ],
  "properties": {
    "schema": { "const": "moso.attempt-review/0.1" },
    "id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "artifact_ref": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "actual_artifact_inspected": { "const": true },
    "scales": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["thumbnail", "use-scale", "full-frame", "detail", "print-distance"] },
      "uniqueItems": true
    },
    "strengths": { "$ref": "#/$defs/stringArray" },
    "deviations": { "$ref": "#/$defs/stringArray" },
    "technical_risks": { "$ref": "#/$defs/stringArray" },
    "target_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "status", "evidence"],
      "properties": {
        "variable": { "type": "string", "minLength": 1 },
        "status": { "enum": ["achieved", "partial", "missed", "unobservable", "not-applicable"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "protected_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["none", "within-tolerance", "exceeded", "unobservable"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "priority_improvement": { "type": "string", "minLength": 1 },
    "recommendation": { "enum": ["accept", "local-repair", "regenerate", "branch", "user-judgment"] },
    "communicated_to_user": { "const": true }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
