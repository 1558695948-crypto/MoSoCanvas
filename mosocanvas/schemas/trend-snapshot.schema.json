{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/trend-snapshot-0.2.json",
  "title": "MoSoCanvas Trend Snapshot 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "captured_at",
    "expires_at",
    "scope",
    "collection",
    "baseline",
    "sources",
    "signals",
    "review"
  ],
  "properties": {
    "schema": { "const": "moso.trend-snapshot/0.2" },
    "id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "minLength": 1 },
    "collection_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector_id",
        "collector_context_id",
        "query_terms",
        "source_classes_requested",
        "status"
      ],
      "properties": {
        "collector_id": { "type": "string", "minLength": 1 },
        "collector_context_id": { "type": "string", "minLength": 1 },
        "query_terms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source_classes_requested": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/sourceClass" },
          "uniqueItems": true
        },
        "status": { "enum": ["complete", "partial"] }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_days", "prior_snapshot_refs"],
      "properties": {
        "window_days": { "const": 7 },
        "prior_snapshot_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "platform",
          "source_class",
          "observed_at",
          "captured_at",
          "creator_or_project",
          "evidence_type"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "platform": { "type": "string", "minLength": 1 },
          "source_class": { "$ref": "#/$defs/sourceClass" },
          "observed_at": { "type": "string", "format": "date-time" },
          "captured_at": { "type": "string", "format": "date-time" },
          "creator_or_project": { "type": "string", "minLength": 1 },
          "evidence_type": {
            "enum": [
              "curated",
              "engagement",
              "recurrence",
              "editorial-report",
              "practitioner-observation"
            ]
          },
          "metric_note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mechanism",
          "source_ids",
          "velocity",
          "velocity_evidence",
          "curation",
          "recurrence",
          "novelty",
          "relevance",
          "saturation_risk",
          "rights_status",
          "confidence",
          "avoid_literal_copy"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mechanism": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "velocity": { "enum": ["unknown", "falling", "stable", "rising", "spiking"] },
          "velocity_evidence": { "type": "string", "minLength": 1 },
          "curation": { "enum": ["none", "weak", "moderate", "strong", "unknown"] },
          "recurrence": { "enum": ["isolated", "limited", "cross-source", "widespread", "unknown"] },
          "novelty": { "enum": ["low", "medium", "high", "unknown"] },
          "relevance": { "enum": ["low", "medium", "high"] },
          "saturation_risk": { "enum": ["low", "medium", "high", "unknown"] },
          "rights_status": { "enum": ["mechanism-only", "authorized", "unknown", "restricted"] },
          "confidence": { "enum": ["low", "medium", "high"] },
          "avoid_literal_copy": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "reviewer_context_id",
        "collector_independent",
        "source_identity_checked",
        "literal_copy_risk_checked",
        "reviewed_at",
        "disposition"
      ],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "reviewer_context_id": { "type": "string", "minLength": 1 },
        "collector_independent": { "const": true },
        "source_identity_checked": { "const": true },
        "literal_copy_risk_checked": { "const": true },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "disposition": { "enum": ["accepted", "rejected"] },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "sourceClass": {
      "enum": [
        "curated-showcase",
        "practitioner-portfolio",
        "editorial-trend-report",
        "community-engagement",
        "model-gallery"
      ]
    }
  }
}
