{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/blind-observation-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "moso.blind-observation/0.1"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "review_context_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "actual_artifact_inspected": {
      "const": true
    },
    "prompt_hidden": {
      "const": true
    },
    "source_hidden": {
      "const": true
    },
    "first_read": {
      "type": "string",
      "minLength": 1
    },
    "eye_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inferred_narrative": {
      "type": "string",
      "minLength": 1
    },
    "observed_anomalies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "reviewer_id",
    "review_context_id",
    "artifact_sha256",
    "committed_at",
    "actual_artifact_inspected",
    "prompt_hidden",
    "source_hidden",
    "first_read",
    "eye_path",
    "inferred_narrative",
    "observed_anomalies",
    "strengths",
    "uncertainties"
  ]
}
