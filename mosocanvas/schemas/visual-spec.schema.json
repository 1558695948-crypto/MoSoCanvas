{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/visual-spec-0.2.json",
  "title": "MoSoCanvas Visual Spec 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "task",
    "proposition",
    "hierarchy",
    "constraints",
    "strategy",
    "evaluation"
  ],
  "properties": {
    "schema": { "const": "moso.visual-spec/0.2" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "parent_version": { "type": "integer", "minimum": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "purpose", "output_context"],
      "properties": {
        "domain": {
          "enum": [
            "social-key-visual",
            "poster",
            "physical-promotional-collateral"
          ]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "output_context": { "type": "string", "minLength": 1 }
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_message", "desired_response"],
      "properties": {
        "primary_message": { "type": "string", "minLength": 1 },
        "desired_response": { "type": "string", "minLength": 1 }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first"],
      "properties": {
        "first": { "type": "string", "minLength": 1 },
        "second": { "type": "string", "minLength": 1 },
        "tertiary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_include"],
      "properties": {
        "must_include": { "$ref": "#/$defs/stringArray" },
        "must_avoid": { "$ref": "#/$defs/stringArray" },
        "preserve": { "$ref": "#/$defs/stringArray" }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_direction", "visual_mechanisms"],
      "properties": {
        "selected_direction": { "type": "string", "minLength": 1 },
        "visual_mechanisms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rejected_directions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_pass_conditions"],
      "properties": {
        "observable_pass_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "user_judgment_required": { "$ref": "#/$defs/stringArray" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "unresolved": { "$ref": "#/$defs/stringArray" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "user_confirmed_at": { "type": "string", "format": "date-time" },
        "change_reason": { "type": "string", "minLength": 1 }
      }
    },
    "reference_analysis_ref": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "lighting": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "minLength": 1 },
        "material_and_texture": { "$ref": "#/$defs/stringArray" },
        "surface_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_material", "detail_inspection_scale", "observable_pass_conditions"],
          "properties": {
            "target_material": { "type": "string", "minLength": 1 },
            "detail_inspection_scale": { "enum": ["100%", "200%", "100–200%"] },
            "pathology_classes": { "$ref": "#/$defs/stringArray" },
            "observable_pass_conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["copy", "render_strategy"],
          "properties": {
            "copy": { "$ref": "#/$defs/stringArray" },
            "treatment": { "type": "string", "minLength": 1 },
            "render_strategy": { "enum": ["overlay", "model", "none"] }
          }
        },
        "reference_use": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "extract", "do_not_copy"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "extract": { "$ref": "#/$defs/nonEmptyStringArray" },
              "do_not_copy": { "$ref": "#/$defs/nonEmptyStringArray" }
            }
          }
        }
      }
    },
    "physical_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finished_size", "artwork_size", "required_copy", "asset_roles"],
      "properties": {
        "finished_size": { "$ref": "#/$defs/physicalSize" },
        "artwork_size": { "$ref": "#/$defs/physicalSize" },
        "bleed": { "type": "string", "minLength": 1 },
        "safe_area": { "type": "string", "minLength": 1 },
        "material": { "type": "string", "minLength": 1 },
        "print_method": { "type": "string", "minLength": 1 },
        "required_copy": { "$ref": "#/$defs/stringArray" },
        "asset_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "source_ref", "status"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "source_ref": { "type": "string", "minLength": 1 },
              "status": { "enum": ["authoritative", "approved", "placeholder", "missing", "unverified"] }
            }
          }
        },
        "delivery_formats": { "$ref": "#/$defs/stringArray" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "domain": { "const": "physical-promotional-collateral" }
            },
            "required": ["domain"]
          }
        },
        "required": ["task"]
      },
      "then": { "required": ["physical_output"] }
    }
  ],
  "$defs": {
    "physicalSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["mm", "cm", "in"] }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
