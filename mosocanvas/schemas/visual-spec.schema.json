{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosocanvas.local/schemas/visual-spec-0.6.json",
  "title": "MoSoCanvas Visual Spec 0.6 (0.4 and 0.5 compatible)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "task", "proposition", "viewer_contract", "hierarchy", "constraints", "strategy", "evaluation"],
  "properties": {
    "schema": { "enum": ["moso.visual-spec/0.4", "moso.visual-spec/0.5", "moso.visual-spec/0.6"] },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "parent_version": { "type": "integer", "minimum": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "purpose", "output_context"],
      "properties": {
        "domain": { "enum": ["social-key-visual", "social-image-series", "poster", "physical-promotional-collateral"] },
        "purpose": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "output_context": { "type": "string", "minLength": 1 }
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_message", "desired_response"],
      "properties": {
        "primary_message": { "type": "string", "minLength": 1 },
        "desired_response": { "type": "string", "minLength": 1 },
        "residual_question": { "type": "string", "minLength": 1 }
      }
    },
    "viewer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_read"],
      "properties": {
        "position": { "enum": ["witness", "target", "intruder", "participant", "judge", "observed-object", "mixed"] },
        "information_power": { "type": "string", "minLength": 1 },
        "first_read": { "type": "string", "minLength": 1 },
        "second_read": { "type": "string", "minLength": 1 },
        "withheld": { "type": "string", "minLength": 1 }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first"],
      "properties": {
        "first": { "type": "string", "minLength": 1 },
        "second": { "type": "string", "minLength": 1 },
        "tertiary": { "$ref": "#/$defs/stringArray" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_include", "must_avoid", "preserve"],
      "properties": {
        "must_include": { "$ref": "#/$defs/stringArray" },
        "must_avoid": { "$ref": "#/$defs/stringArray" },
        "preserve": { "$ref": "#/$defs/stringArray" }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "relation", "object", "intended_effect", "scale", "pass_condition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "object": { "type": "string", "minLength": 1 },
          "intended_effect": { "type": "string", "minLength": 1 },
          "scale": { "enum": ["thumbnail", "use-scale", "full-frame", "detail", "print-distance", "all"] },
          "pass_condition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "perceptual_reveals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "element", "first_detectable_at", "must_not_dominate_at", "pass_condition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "element": { "type": "string", "minLength": 1 },
          "first_detectable_at": { "enum": ["thumbnail", "use-scale", "full-frame", "detail"] },
          "must_not_dominate_at": { "enum": ["thumbnail", "use-scale", "full-frame", "detail", "never"] },
          "pass_condition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_direction", "structural_mechanisms"],
      "properties": {
        "selected_direction": { "type": "string", "minLength": 1 },
        "structural_mechanisms": { "$ref": "#/$defs/oneToThreeStrings" },
        "familiar_rule": { "type": "string", "minLength": 1 },
        "designed_anomaly": { "type": "string", "minLength": 1 },
        "rejected_directions": { "$ref": "#/$defs/stringArray" },
        "trend_snapshot_ref": { "type": "string", "minLength": 1 },
        "trend_use": { "enum": ["not-used", "counter-signal", "mechanism-check", "carrier-calibration"] }
      }
    },
    "expression_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concepts", "space"],
      "properties": {
        "concepts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/conceptDecision" } },
        "space": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "instruction"],
          "properties": {
            "mode": { "enum": ["flat", "shallow", "deep", "mixed"] },
            "instruction": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1 }
          },
          "allOf": [{
            "if": { "properties": { "mode": { "enum": ["deep", "mixed"] } } },
            "then": { "required": ["reason"] }
          }]
        },
        "detail_distribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "instruction"],
            "properties": {
              "region": { "type": "string", "minLength": 1 },
              "instruction": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "shot_plan_ref": { "type": "string", "minLength": 1 },
    "series_plan_ref": { "type": "string", "minLength": 1 },
    "reference_analysis_ref": { "type": "string", "minLength": 1 },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_pass_conditions", "known_failure_signs", "user_judgment_required"],
      "properties": {
        "observable_pass_conditions": { "$ref": "#/$defs/nonEmptyStringArray" },
        "known_failure_signs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "user_judgment_required": { "$ref": "#/$defs/stringArray" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumptions": { "$ref": "#/$defs/stringArray" },
        "unresolved": { "$ref": "#/$defs/stringArray" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "source_refs"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "source_refs": { "$ref": "#/$defs/stringArray" },
        "user_confirmed_at": { "type": "string", "format": "date-time" },
        "change_reason": { "type": "string", "minLength": 1 }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "color_light": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "variant": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "variant"
          ]
        },
        "text": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "enum": [
                  "generated",
                  "overlay"
                ]
              }
            },
            "required": [
              "id",
              "text",
              "placement",
              "method"
            ]
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "subject",
                  "identity",
                  "layout",
                  "style",
                  "material",
                  "background",
                  "edit-parent"
                ]
              },
              "use": {
                "type": "string",
                "minLength": 1
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "path",
              "role",
              "use",
              "exclude"
            ]
          }
        },
        "requested_parameters": {
          "type": "object"
        },
        "target_size": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checkpoint_ref": {
              "type": "string",
              "minLength": 1
            },
            "spec_ref": {
              "type": "string",
              "minLength": 1
            },
            "spec_version": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "checkpoint_ref",
            "spec_ref",
            "spec_version",
            "sha256"
          ]
        }
      },
      "required": [
        "subject"
      ]
    },
    "physical_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finished_size", "artwork_size", "required_copy", "asset_roles"],
      "properties": {
        "finished_size": { "$ref": "#/$defs/physicalSize" },
        "artwork_size": { "$ref": "#/$defs/physicalSize" },
        "bleed": { "type": "string", "minLength": 1 },
        "safe_area": { "type": "string", "minLength": 1 },
        "material": { "type": "string", "minLength": 1 },
        "print_method": { "type": "string", "minLength": 1 },
        "required_copy": { "$ref": "#/$defs/stringArray" },
        "asset_roles": { "$ref": "#/$defs/stringArray" },
        "delivery_formats": { "$ref": "#/$defs/stringArray" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "task": { "properties": { "domain": { "const": "social-image-series" } } } } },
      "then": { "required": ["shot_plan_ref", "series_plan_ref"] }
    },
    {
      "if": { "properties": { "task": { "properties": { "domain": { "const": "physical-promotional-collateral" } } } } },
      "then": { "required": ["physical_output"] }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "enum": ["moso.visual-spec/0.5", "moso.visual-spec/0.6"]
          }
        }
      },
      "then": {
        "required": [
          "generation"
        ]
      }
    },
    {
      "if": { "properties": { "schema": { "const": "moso.visual-spec/0.6" } } },
      "then": { "required": ["expression_plan"] },
      "else": {
        "not": { "required": ["expression_plan"] },
        "properties": {
          "proposition": { "required": ["residual_question"] },
          "viewer_contract": { "required": ["position", "information_power", "second_read", "withheld"] },
          "strategy": { "required": ["familiar_rule", "designed_anomaly"] }
        }
      }
    }
  ],
  "$defs": {
    "conceptDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "concept", "treatment", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "concept": { "type": "string", "minLength": 1 },
        "treatment": { "enum": ["explicit", "relational", "context-only", "omit"] },
        "reason": { "type": "string", "minLength": 1 },
        "required_visible": { "type": "boolean" },
        "constraint_refs": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^constraints\\.(must_include|preserve)\\[[0-9]+\\]$" }
        },
        "render_instruction": { "type": "string", "minLength": 1 },
        "relationship_refs": { "$ref": "#/$defs/nonEmptyStringArray" },
        "expected_loss": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "treatment": { "const": "explicit" } } },
          "then": { "required": ["render_instruction"], "not": { "required": ["relationship_refs"] } }
        },
        {
          "if": { "properties": { "treatment": { "const": "relational" } } },
          "then": { "required": ["relationship_refs"], "not": { "required": ["render_instruction"] } }
        },
        {
          "if": { "properties": { "treatment": { "enum": ["context-only", "omit"] } } },
          "then": {
            "required": ["expected_loss"],
            "not": { "anyOf": [{ "required": ["render_instruction"] }, { "required": ["relationship_refs"] }] }
          }
        },
        {
          "if": { "required": ["required_visible"], "properties": { "required_visible": { "const": true } } },
          "then": { "properties": { "treatment": { "const": "explicit" } } }
        },
        {
          "if": { "required": ["constraint_refs"], "properties": { "constraint_refs": { "minItems": 1 } } },
          "then": { "properties": { "treatment": { "enum": ["explicit", "relational"] } } }
        }
      ]
    },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "oneToThreeStrings": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "physicalSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["mm", "cm", "in"] }
      }
    }
  }
}
